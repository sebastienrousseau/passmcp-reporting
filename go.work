// The agentgateway processor builds against the verifier in this checkout,
// at the same commit, whenever it is built from the tree. A workspace does
// that without a replace directive in the processor's go.mod, which go
// install refuses; go.work is never part of a published module.
go 1.26.8

use (
	.
	./integrations/agentgateway-extmcp
)
